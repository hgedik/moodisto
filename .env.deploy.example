# ---------------------------------------------------------------------------
# Moodisto deployment environment
# ---------------------------------------------------------------------------
# Copy to .env.deploy next to docker-compose.deploy.yml and fill in. Only the
# API reads these: the web image carries no configuration, because Next.js
# inlines its own settings at build time and this one is built to talk to the
# domain it is served from.
#
# Nothing here belongs in git. Generate every secret on the server:
#   openssl rand -base64 32

# --- Images ----------------------------------------------------------------
# Pin a digest or a dated tag in production, so a restart cannot silently pick
# up a different build.
API_IMAGE=mobven/test:moodisto-api
WEB_IMAGE=mobven/test:moodisto-web

# --- Published ports -------------------------------------------------------
# Both are bound to 127.0.0.1; the reverse proxy is what reaches them.
API_PORT=3001
WEB_PORT=3000

# --- Database --------------------------------------------------------------
# Managed outside this stack. From inside a container `localhost` is the
# container itself: use the host's address, a service name on a shared network,
# or host.docker.internal.
DATABASE_URL="postgresql://moodisto:CHANGE_ME@db.internal:5432/moodisto?schema=public"

# --- Addresses -------------------------------------------------------------
# One domain in front of both services, with the proxy routing /api and
# /socket.io to the API and everything else to the web container.
APP_URL="https://moodisto.example.com"
API_URL="https://moodisto.example.com"
CORS_ORIGINS="https://moodisto.example.com"

# production is what marks the auth cookies Secure — correct behind TLS, and
# the reason a plain-http deployment cannot sign anyone in.
NODE_ENV=production

# --- Secrets ---------------------------------------------------------------
COOKIE_SECRET="CHANGE_ME-at-least-32-characters-long"
JWT_SECRET="CHANGE_ME-at-least-32-characters-long"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Encrypts the provider keys stored in the database. Losing it means the stored
# integration keys can no longer be read and have to be entered again.
SETTINGS_ENCRYPTION_KEY="CHANGE_ME-exactly-32-characters!!"

# --- Music provider --------------------------------------------------------
# The key is only a fallback: the system console writes it to the database,
# which wins. It never reaches the browser either way.
MUSIC_PROVIDER="YOUTUBE"
YOUTUBE_API_KEY=""
YOUTUBE_REGION_CODE="TR"
YOUTUBE_RELEVANCE_LANGUAGE="tr"
MUSIC_PROVIDER_FAKE=false

# --- Payments --------------------------------------------------------------
# The mock provider must not settle real money: with it selected, paid requests
# have to stay off.
PAYMENT_PROVIDER="iyzico"
PAYMENT_API_KEY=""
PAYMENT_SECRET=""
PAYMENT_BASE_URL="https://api.iyzipay.com"
PAYMENT_WEBHOOK_SECRET="CHANGE_ME"
ENABLE_PAID_REQUESTS=true
ENABLE_YOUTUBE_PLAYBACK=true
RATE_LIMIT_ENABLED=true

# --- Seed accounts ---------------------------------------------------------
# Read only by the `seed` profile. Leave the demo data alone on a real venue.
SEED_OWNER_EMAIL="admin@example.com"
SEED_OWNER_PASSWORD="CHANGE_ME"
SEED_SYSTEM_EMAIL="system@example.com"
SEED_SYSTEM_PASSWORD="CHANGE_ME"
