// Moodisto persistence model.
//
// PostgreSQL is the single source of truth for the queue and for player state. The browser and
// any music provider are treated as replaceable details: nothing here stores a YouTube video id
// under a YouTube-specific name, only `provider` + `providerTrackId`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MusicProvider {
  YOUTUBE
}

enum RequestType {
  NORMAL
  PRIORITY
  DJ
  PLAY_NEXT
}

enum RequestStatus {
  PENDING_PAYMENT
  PENDING
  ACCEPTED
  REJECTED
  QUEUED
  PLAYING
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

enum QueueItemState {
  QUEUED
  PLAYING
  COMPLETED
  REMOVED
  FAILED
}

enum PlaybackState {
  IDLE
  LOADING
  PLAYING
  PAUSED
  ERROR
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BlockedRuleType {
  TRACK
  CHANNEL
  KEYWORD
}

enum VenueUserRole {
  OWNER
  MANAGER
  DJ
}

model Venue {
  id                       String   @id @default(cuid())
  slug                     String   @unique
  name                     String
  description              String?
  address                  String?
  latitude                 Float?
  longitude                Float?
  timezone                 String   @default("Europe/Istanbul")
  logoUrl                  String?
  active                   Boolean  @default(true)
  duplicateCooldownMinutes Int      @default(30)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  users            VenueUser[]
  pricing          VenueRequestPricing?
  qrCodes          VenueQrCode[]
  songRequests     SongRequest[]
  queueItems       QueueItem[]
  blockedRules     BlockedMusicRule[]
  playerState      PlayerState?
  playerLease      PlayerLease?
  customerSessions CustomerSession[]

  @@index([active])
  @@index([latitude, longitude])
  @@map("venues")
}

model VenueUser {
  id           String        @id @default(cuid())
  venueId      String
  email        String        @unique
  passwordHash String
  name         String
  role         VenueUserRole @default(MANAGER)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("venue_users")
}

/// Per-venue request pricing. Money is always an integer amount of the currency's minor unit.
model VenueRequestPricing {
  id                 String   @id @default(cuid())
  venueId            String   @unique
  currency           String   @default("TRY")
  normalEnabled      Boolean  @default(true)
  normalPriceMinor   Int      @default(0)
  priorityEnabled    Boolean  @default(true)
  priorityPriceMinor Int      @default(2000)
  djEnabled          Boolean  @default(true)
  djPriceMinor       Int      @default(3000)
  playNextEnabled    Boolean  @default(true)
  playNextPriceMinor Int      @default(5000)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_request_pricing")
}

model VenueQrCode {
  id         String    @id @default(cuid())
  venueId    String
  token      String    @unique
  tableLabel String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, active])
  @@map("venue_qr_codes")
}

/// Anonymous customer identity. No name, no email: joining a venue must stay frictionless.
model CustomerSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  venueId      String?
  tableLabel   String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  venue        Venue?        @relation(fields: [venueId], references: [id], onDelete: SetNull)
  songRequests SongRequest[]

  @@index([venueId])
  @@map("customer_sessions")
}

/// A playable track, identified only by provider + provider track id.
/// Every track a search has ever returned, kept for good: the local catalogue is searched before
/// the provider is, so a track seen once never costs provider quota again.
model Track {
  id                String        @id @default(cuid())
  provider          MusicProvider
  providerTrackId   String
  title             String
  artist            String?
  channelName       String?
  channelId         String?
  thumbnailUrl      String?
  durationSeconds   Int?
  metadata          Json          @default("{}")
  /// Diacritic-folded title, artist and channel, searched with trigram similarity.
  searchText        String        @default("")
  /// Last time this track played through to the end somewhere; ranks proven tracks first.
  lastPlayedOkAt    DateTime?
  /// Set only when the provider itself refused the track (not embeddable, gone). Venue-side
  /// failures never land here, because the catalogue is shared between venues.
  playbackBlockedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  songRequests SongRequest[]
  playerStates PlayerState[]

  @@unique([provider, providerTrackId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("tracks")
}

/// Cached provider search results, keyed by the normalised query.
model MusicSearchCache {
  id              String        @id @default(cuid())
  provider        MusicProvider
  normalizedQuery String
  resultJson      Json
  createdAt       DateTime      @default(now())
  expiresAt       DateTime

  @@unique([provider, normalizedQuery])
  @@index([expiresAt])
  @@map("music_search_cache")
}

/// What Moodisto has already spent of a provider's daily allowance.
///
/// PostgreSQL is the source of truth here too: restarting the API must not forget the day's spend,
/// and two API instances must not each believe they have a full allowance.
model ProviderQuotaUsage {
  id         String        @id @default(cuid())
  provider   MusicProvider
  /// Calendar day in the provider's own reset time zone, as YYYY-MM-DD.
  periodKey  String
  spentUnits Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([provider, periodKey])
  @@map("provider_quota_usage")
}

model SongRequest {
  id                String        @id @default(cuid())
  venueId           String
  customerSessionId String?
  trackId           String
  requestType       RequestType
  status            RequestStatus @default(PENDING)
  amountMinor       Int           @default(0)
  currency          String        @default("TRY")
  tableLabel        String?
  rejectionReason   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  queuedAt          DateTime?
  playingAt         DateTime?
  completedAt       DateTime?

  venue           Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  customerSession CustomerSession? @relation(fields: [customerSessionId], references: [id], onDelete: SetNull)
  track           Track            @relation(fields: [trackId], references: [id], onDelete: Restrict)
  queueItem       QueueItem?
  payment         Payment?

  @@index([venueId, status, createdAt])
  @@index([venueId, trackId, status])
  @@index([venueId, createdAt])
  @@index([customerSessionId, createdAt])
  @@map("song_requests")
}

/// The venue queue. `position` is explicit and unique among the rows that still hold a slot.
model QueueItem {
  id            String         @id @default(cuid())
  venueId       String
  songRequestId String         @unique
  position      Int
  state         QueueItemState @default(QUEUED)
  createdAt     DateTime       @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  songRequest SongRequest  @relation(fields: [songRequestId], references: [id], onDelete: Cascade)
  playerState PlayerState?

  @@index([venueId, state, position])
  @@map("queue_items")
}

/// Server-side playback state. The browser is a renderer, never the owner of this record.
model PlayerState {
  id          String        @id @default(cuid())
  venueId     String        @unique
  queueItemId String?       @unique
  trackId     String?
  state       PlaybackState @default(IDLE)
  version     Int           @default(0)
  startedAt   DateTime?
  pausedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  queueItem QueueItem? @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  track     Track?     @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@map("player_states")
}

/// Guarantees that only one browser tab drives playback for a venue at a time.
model PlayerLease {
  id              String   @id @default(cuid())
  venueId         String   @unique
  sessionId       String
  lastHeartbeatAt DateTime @default(now())
  createdAt       DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("player_leases")
}

model Payment {
  id                String        @id @default(cuid())
  songRequestId     String        @unique
  provider          String
  providerPaymentId String?
  amountMinor       Int
  currency          String
  status            PaymentStatus @default(PENDING)
  metadata          Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?
  refundedAt        DateTime?

  songRequest SongRequest @relation(fields: [songRequestId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([status, createdAt])
  @@map("payments")
}

model BlockedMusicRule {
  id        String          @id @default(cuid())
  venueId   String
  type      BlockedRuleType
  value     String
  createdAt DateTime        @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, type, value])
  @@index([venueId])
  @@map("blocked_music_rules")
}

/// The operator of the installation itself, not of any venue: it owns no venue and joins no
/// queue, it only maintains the integration settings below.
model SystemUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  settings SystemSetting[]

  @@map("system_users")
}

/// Settings that must be changeable without a deploy. Secret values live only in `valueCipher`,
/// encrypted at rest; a missing row means the environment variable still decides.
model SystemSetting {
  key         String   @id
  valueText   String?
  valueCipher String?
  secret      Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy SystemUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}
