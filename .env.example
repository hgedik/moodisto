# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://moodisto:moodisto@localhost:5433/moodisto?schema=public"
TEST_DATABASE_URL="postgresql://moodisto:moodisto@localhost:5433/moodisto_test?schema=public"
# The Playwright suite resets this database on every run and starts its own servers on ports
# 3010/3011, so it never touches development data or development ports.
E2E_DATABASE_URL="postgresql://moodisto:moodisto@localhost:5433/moodisto_e2e?schema=public"
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Application URLs
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
API_PORT=3001
# Comma separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:3000"

# Consumed by the Next.js app at build time. Must be reachable from the browser.
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set only by the Playwright suite: replaces the provider embed with a stand-in that exposes
# "track ended" and "playback failed" controls. Never set this in development or production.
# NEXT_PUBLIC_PLAYER_STUB=1

# ---------------------------------------------------------------------------
# Secrets - never commit real values
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET="change-me-cookie-secret-at-least-32-characters"
JWT_SECRET="change-me-jwt-secret-at-least-32-characters"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Music provider
# ---------------------------------------------------------------------------
MUSIC_PROVIDER="YOUTUBE"
YOUTUBE_API_KEY=""
YOUTUBE_REGION_CODE="TR"
YOUTUBE_RELEVANCE_LANGUAGE="tr"
# When true the API answers /music/search from a deterministic in-memory catalogue instead of
# calling YouTube. Used by the integration and end-to-end suites, and by offline development.
MUSIC_PROVIDER_FAKE=false

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# iyzico | mock
PAYMENT_PROVIDER="mock"
PAYMENT_API_KEY=""
PAYMENT_SECRET=""
PAYMENT_BASE_URL="https://sandbox-api.iyzipay.com"
# Shared secret used to verify mock provider webhooks in development and tests.
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
ENABLE_PAID_REQUESTS=true
ENABLE_YOUTUBE_PLAYBACK=true

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Seed (development only)
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL="admin@example.com"
SEED_OWNER_PASSWORD="moodisto-dev-2026"
