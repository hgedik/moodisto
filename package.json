{
  "name": "moodisto",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm run build:packages && pnpm --filter @moodisto/api build && pnpm --filter @moodisto/web build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel --filter @moodisto/api --filter @moodisto/web dev",
    "dev:api": "pnpm --filter @moodisto/api dev",
    "dev:web": "pnpm --filter @moodisto/web dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @moodisto/api test:integration",
    "test:e2e": "pnpm --filter @moodisto/e2e e2e",
    "db:generate": "pnpm --filter @moodisto/database generate",
    "db:migrate": "pnpm --filter @moodisto/database migrate",
    "db:migrate:deploy": "pnpm --filter @moodisto/database migrate:deploy",
    "db:reset": "pnpm --filter @moodisto/database reset",
    "db:seed": "pnpm --filter @moodisto/database seed",
    "db:studio": "pnpm --filter @moodisto/database studio",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.23",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@swc/core",
      "argon2",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
