{
  "name": "@moodisto/api",
  "version": "0.1.0",
  "private": true,
  "description": "Moodisto backend: request lifecycle, queue engine orchestration, realtime and payments.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@moodisto/database": "workspace:*",
    "@moodisto/music-provider": "workspace:*",
    "@moodisto/queue-engine": "workspace:*",
    "@moodisto/shared-types": "workspace:*",
    "@moodisto/validation": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "argon2": "^0.43.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.11.24",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.1.2"
  }
}
